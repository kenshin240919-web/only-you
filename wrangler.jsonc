{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "only-you",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "only-you"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "only-u-song-db",
      "migrations_dir": "migrations"
    }
  ],
  // 완성된 노래 mp3 저장소.
  "r2_buckets": [
    {
      "binding": "SONGS",
      "bucket_name": "only-u-song-audio"
    }
  ],
  // MUSIC_GENERATION: "on"일 때만 결제된 주문으로 ElevenLabs에 실제 생성을 요청한다(과금). API 키는 비밀 값 ELEVENLABS_API_KEY로 넣는다.
  "vars": {
    "MUSIC_GENERATION": "off",
    // "payapp"이면 페이앱으로 실제 결제를 받는다. 비밀 값 PAYAPP_USERID · PAYAPP_LINKKEY · PAYAPP_LINKVAL이 모두 있어야 켜진다.
    "PAYMENT_MODE": "mock",
    // 메일·링크에 쓰는 사이트 주소. 정식 도메인을 연결하면 바꾼다.
    "SITE_URL": "https://only-you.kenshin240919.workers.dev",
    // 알림 메일 보내는 주소(이메일 서비스에 등록한 도메인). 비어 있으면 메일을 보내지 않는다.
    "MAIL_FROM": "",
    // 제작 실패를 알려 받을 운영자 메일.
    "ADMIN_EMAIL": "lbkneon275@naver.com"
  },
  "observability": {
    "enabled": true
  }
}
