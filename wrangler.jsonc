{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "only-you",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "only-you"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "only-u-song-db",
      "migrations_dir": "migrations"
    }
  ],
  // 완성된 노래 mp3 저장소.
  "r2_buckets": [
    {
      "binding": "SONGS",
      "bucket_name": "only-u-song-audio"
    }
  ],
  // MUSIC_GENERATION: "on"일 때만 결제된 주문으로 ElevenLabs에 실제 생성을 요청한다(과금). API 키는 비밀 값 ELEVENLABS_API_KEY로 넣는다.
  "vars": {
    "MUSIC_GENERATION": "on",
    // "payapp"이면 페이앱으로 실제 결제를 받는다(2026-10-23 오픈). 비밀 값 PAYAPP_USERID · PAYAPP_LINKKEY · PAYAPP_LINKVAL이
    // 하나라도 없으면 결제를 받지 않는다. "mock"(모의 결제, 결제 없이 통과)은 개발용으로만 쓴다.
    "PAYMENT_MODE": "payapp",
    // 페이앱 판매자 아이디(결제창에도 보이는 값이라 공개해도 됨). 연동 KEY·VALUE는 비밀 값으로만 넣는다.
    "PAYAPP_USERID": "onlyusong",
    // 메일·링크에 쓰는 사이트 주소(정식 도메인). 예전 workers.dev 주소도 계속 열어 둔다(이미 저장된 가사 카드 QR).
    "SITE_URL": "https://song.guidejung.com",
    // 알림 메일 보내는 주소(이메일 서비스에 등록한 도메인). 비어 있으면 메일을 보내지 않는다.
    "MAIL_FROM": "noreply@song.guidejung.com",
    // 제작 실패를 알려 받을 운영자 메일.
    "ADMIN_EMAIL": "lbkneon275@naver.com",
    // ElevenLabs 요금제의 월 크레딧과 갱신일(매월 며칠). 관리자 화면의 사용량 경고에 쓴다. 요금제를 바꾸면 함께 바꾼다.
    "MUSIC_PLAN_CREDITS": "40000",
    "MUSIC_CYCLE_DAY": "19",
    // 생성 기록을 남기기 전(2026-10-20 이전)에 이번 주기에서 이미 쓴 크레딧. 그 주기에만 더하고, 다음 주기부터는 무시된다.
    "MUSIC_CREDITS_BEFORE_LOG": "21000"
  },
  // 알림 메일 발송(Cloudflare Email Service, song.guidejung.com 등록 2026-10-20).
  "send_email": [{ "name": "EMAIL" }],
  "observability": {
    "enabled": true
  }
}
